<IfModule php8_module>
   php_value error_log "/home/afrrxwxq/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/afrrxwxq/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# توجيه الموقع ليعمل من مجلد public مباشرة بدون ظهوره في الرابط
<IfModule mod_rewrite.c>
    RewriteEngine On

    # إذا كان الطلب لا يشير مسبقاً إلى مجلد public
    RewriteCond %{REQUEST_URI} !^/public/
    
    # قم بتوجيه الطلب داخلياً إلى مجلد public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>